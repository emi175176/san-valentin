</span><span class="x1lliihq">    padding:0;
</span><span class="x1lliihq">    font-family: Arial, sans-serif;
</span><span class="x1lliihq">    background: linear-gradient(black, #0d001a);
</span><span class="x1lliihq">    color:white;
</span><span class="x1lliihq">    text-align:center;
</span><span class="x1lliihq">    overflow-x:hidden;
</span><span class="x1lliihq">}
</span><span class="x1lliihq">
</span><span class="x1lliihq">/* Fondo de estrellas */
</span><span class="x1lliihq">body::before{
</span><span class="x1lliihq">    content:"";
</span><span class="x1lliihq">    position:fixed;
</span><span class="x1lliihq">    width:100%;
</span><span class="x1lliihq">    height:100%;
</span><span class="x1lliihq">    background:url("<a href="https://www.transparenttextures.com/patterns/stardust.png" target="_blank" rel="noopener noreferrer" dir="ltr" class="_ao3e _aupe copyable-text x1bvjpef x1lku1pv x11iimpl xbvygy2 x1wp9yj1 x1e2wovf x1ph7ams x17f7hit xn69kzl xrys4gj xhmieyt xtnn1bt x9v5kkp xmw7ebm xrdum7p" title="https://www.transparenttextures.com/patterns/stardust.png" data-testid="selectable-text">https://www.transparenttextures.com/patterns/stardust.png</a>");
</span><span class="x1lliihq">    opacity:0.4;
</span><span class="x1lliihq">    z-index:-1;
</span><span class="x1lliihq">}
</span><span class="x1lliihq">
</span><span class="x1lliihq">/* Título */
</span><span class="x1lliihq">h1{
