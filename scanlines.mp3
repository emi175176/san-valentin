</span><span class="x1lliihq">&lt;head&gt;
</span><span class="x1lliihq">&lt;meta charset="UTF-8"&gt;
</span><span class="x1lliihq">&lt;title&gt;Para Estrella <img crossorigin="anonymous" alt="✨" draggable="false" data-testid="selectable-text" class="b7 emoji wa  _ao3e _aupe copyable-text" data-plain-text="✨" tabindex="-1" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" style="background-position: -40px -40px;">&lt;/title&gt;&lt;style&gt;
</span><span class="x1lliihq">body{
</span><span class="x1lliihq">    margin:0;
</span><span class="x1lliihq">    overflow:hidden;
</span><span class="x1lliihq">    font-family: Arial, sans-serif;
</span><span class="x1lliihq">    background:black;
</span><span class="x1lliihq">    color:white;
</span><span class="x1lliihq">    text-align:center;
</span><span class="x1lliihq">}
</span><span class="x1lliihq">
</span><span class="x1lliihq">/* Pantalla inicio */
</span><span class="x1lliihq">#inicio{
</span><span class="x1lliihq">    position:absolute;
</span><span class="x1lliihq">    width:100%;
</span><span class="x1lliihq">    height:100vh;
</span><span class="x1lliihq">    display:flex;
</span><span class="x1lliihq">    justify-content:center;
</span><span class="x1lliihq">    align-items:center;
</span><span class="x1lliihq">    flex-direction:column;
</span><span class="x1lliihq">    background:black;
</span><span class="x1lliihq">    z-index:10;
</span><span class="x1lliihq">}
</span><span class="x1lliihq">
</span><span class="x1lliihq">#inicio button{
</span><span class="x1lliihq">    padding:15px 30px;
</span><span class="x1lliihq">    font-size:20px;
</span><span class="x1lliihq">    border:none;
</span><span class="x1lliihq">    border-radius:30px;
</span><span class="x1lliihq">    background:#ff4e8a;
</span><span class="x1lliihq">    color:white;
</span><span class="x1lliihq">    cursor:pointer;
</span><span class="x1lliihq">}
</span><span class="x1lliihq">
</span><span class="x1lliihq">/* Contenido principal */
</span><span class="x1lliihq">#contenido{
</span><span class="x1lliihq">    display:none;
</span><span class="x1lliihq">    position:relative;
</span><span class="x1lliihq">    top:10%;
</span><span class="x1lliihq">}
</span><span class="x1lliihq">
